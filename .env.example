# Form destination is auto-selected:
# 1) HubSpot when portal + form GUID are set
# 2) Formspree when FORMSPREE_FORM_ID is set
# 3) Mock/file fallback (data/leads.jsonl) so local preview still validates

# HubSpot Forms API v3
HUBSPOT_PORTAL_ID=
HUBSPOT_SOFT_FORM_GUID=
HUBSPOT_HARD_FORM_GUID=

# Formspree-compatible fallback (https://formspree.io/f/{id})
FORMSPREE_FORM_ID=

# Optional Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional GA4
NEXT_PUBLIC_GA_MEASUREMENT_ID=
